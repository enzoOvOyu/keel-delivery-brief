oint x="1320" y="477.5" /><mxPoint x="1320" y="670" /><mxPoint x="1020" y="670" /><mxPoint x="1020" y="930" /><mxPoint x="1060" y="930" /><mxPoint x="1060" y="1010" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="pass" value="PASS&lt;br&gt;所需有效证据全PASS且覆盖满足" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1200" width="330" height="120" /></mxCell><mxCell id="bad" value="FAIL / BLOCKED&lt;br&gt;已证明违反判据／必需证明不足&lt;br&gt;混合结论汇总策略待确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="1200" width="390" height="120" /></mxCell><mxCell id="waived" value="WAIVED&lt;br&gt;适用范围／期限／审批／整改&lt;br&gt;不得改写PASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="1200" width="330" height="120" /></mxCell><mxCell id="o0" value="" source="merge" target="pass" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="620" y="1010.0" /><mxPoint x="620" y="1190" /><mxPoint x="420" y="1190" /><mxPoint x="420" y="1260" /></Array></mxGeometry></mxCell><mxCell id="o1" value="" source="merge" target="bad" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="840.0" y="1100" /><mxPoint x="660" y="1100" /><mxPoint x="660" y="1180" /><mxPoint x="665.0" y="1180" /></Array></mxGeometry></mxCell><mxCell id="o2" value="" source="merge" target="waived" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="840" y="1180" /><mxPoint x="1085.0" y="1180" /></Array></mxGeometry></mxCell><mxCell id="note" value="30 秒打流不能单独证明 3600 秒 ECN 规则已验证；未触发规则不能代替网络验收；抽样通过不能外推全路径。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1370" width="1470" height="90" /></mxCell></root></mxGraphModel></diagram><diagram id="page-4" name="0.1 修复与定向复验"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;公共流程：版本变化与 0.1 修复复验&lt;/b&gt;&lt;br&gt;实线为处理或影响关系；虚线为变更、异常或恢复分支。事务与租约属于实现建议。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="20" width="1500" height="85" /></mxCell><mxCell id="freeze" value="冻结请求上下文&lt;br&gt;目标hash／依赖版本／审批范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="170" width="290" height="160" /></mxCell><mxCell id="admit" value="派发前核验&lt;br&gt;权限／版本／就绪／资源租约" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="170" width="290" height="160" /></mxCell><mxCell id="run" value="执行尝试&lt;br&gt;执行尝试／动作幂等键&lt;br&gt;回执与原始结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="780" y="170" width="290" height="160" /></mxCell><mxCell id="commit" value="发布前复核版本&lt;br&gt;原始结果落库＋证据引用一致&lt;br&gt;禁止过时写覆盖当前状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="170" width="290" height="160" /></mxCell><mxCell id="change" value="相关版本或物理对象变化&lt;br&gt;新配置版本／换卡／换线／规则更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="540" width="290" height="160" /></mxCell><mxCell id="history" value="旧结果仍保存&lt;br&gt;历史PASS可以成立&lt;br&gt;对当前任务不再可消费" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="540" width="290" height="160" /></mxCell><mxCell id="retry" value="0.1 修复与定向复验&lt;br&gt;重新核验当前条件&lt;br&gt;受控复验只豁免本故障的阻断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="780" y="540" width="290" height="160" /></mxCell><mxCell id="unknown" value="断线／超时／结果不明&lt;br&gt;先查回执和设备实际状态&lt;br&gt;不能直接重放高副作用动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="540" width="290" height="160" /></mxCell><mxCell id="e0" value="" source="freeze" target="admit" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="" source="admit" target="run" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="" source="run" target="commit" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e3" value="影响依赖范围" source="change" target="history" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="-96.0" /></mxGeometry></mxCell><mxCell id="e4" value="变更导致发布前提不匹配" source="change" target="commit" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B07920;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.7345132743362832" y="0"><Array as="points"><mxPoint x="380" y="620.0" /><mxPoint x="380" y="340" /><mxPoint x="1120" y="340" /><mxPoint x="1120" y="250" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e5" value="补足证明" source="history" target="retry" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B07920;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="-96.0" /></mxGeometry></mxCell><mxCell id="e6" value="无最终回执" source="run" target="unknown" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B07920;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.631578947368421" y="0"><Array as="points"><mxPoint x="925.0" y="340" /><mxPoint x="920" y="340" /><mxPoint x="920" y="520" /><mxPoint x="1275.0" y="520" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e7" value="对账后安全恢复" source="unknown" target="retry" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B07920;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="-96.0" /></mxGeometry></mxCell><mxCell id="e8" value="新上下文" source="retry" target="freeze" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B07920;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.6025641025641026" y="0"><Array as="points"><mxPoint x="760" y="620.0" /><mxPoint x="760" y="350" /><mxPoint x="380" y="350" /><mxPoint x="380" y="250" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="ttl" value="&lt;b&gt;时间语义&lt;/b&gt;&lt;br&gt;30 秒就绪有效期用于消费或派发时检查，不要求长任务 30 秒内结束。观测窗口、采样新鲜度与验收证明有效期分别核对。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="930" width="1420" height="140" /></mxCell></root></mxGraphModel></diagram><diagram id="page-5" name="5 NCCL 测试与评审"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;5 NCCL 测试与评审&lt;/b&gt;&lt;br&gt;实线为处理顺序或证据消费，虚线为整组失败后的恢复。步骤编号与流程卡一致。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="20" width="1450" height="85" /></mxCell><mxCell id="N01" value="&lt;b&gt;5.1 检查通信组运行条件&lt;/b&gt;&lt;br&gt;确认本通信组可安全启动测试&lt;br&gt;并具备解释结果所需的证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="160" width="340" height="140" /></mxCell><mxCell id="N02" value="&lt;b&gt;5.2 准备一致的测试环境&lt;/b&gt;&lt;br&gt;使组内使用冻结且一致的软件环境。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="360" width="340" height="140" /></mxCell><mxCell id="N03" value="&lt;b&gt;5.3 执行通信组测试&lt;/b&gt;&lt;br&gt;按型号与覆盖模式&lt;br&gt;执行机内、跨机和全目标通信测试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="560" width="340" height="140" /></mxCell><mxCell id="N04" value="&lt;b&gt;5.4 回收结果并核对检测场景&lt;/b&gt;&lt;br&gt;将原始结果转换为保持测量粒度的指标。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="560" width="340" height="140" /></mxCell><mxCell id="N05" value="&lt;b&gt;5.5 生成测试报告&lt;/b&gt;&lt;br&gt;生成可追溯到具体测试规模和尝试的报告。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1000" y="560" width="340" height="140" /></mxCell><mxCell id="N06" value="&lt;b&gt;5.6 追踪失败原因&lt;/b&gt;&lt;br&gt;将异常关联到可处置对象及历史基线。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1000" y="780" width="340" height="140" /></mxCell><mxCell id="N07" value="&lt;b&gt;5.7 汇总调优建议&lt;/b&gt;&lt;br&gt;形成可审查且能回流版本化配置的改进建议。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="780" width="340" height="140" /></mxCell><mxCell id="N08" value="&lt;b&gt;5.8 评审报告与退出条件&lt;/b&gt;&lt;br&gt;确认本次交付测试达标并完成调优清单确认。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="780" width="340" height="140" /></mxCell><mxCell id="e0" value="" source="N01" target="N02" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="" source="N02" target="N03" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="" source="N03" target="N04" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e3" value="" source="N04" target="N05" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" value="" source="N05" target="N06" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e5" value="" source="N06" target="N07" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="e6" value="" source="N07" target="N08" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="retry" value="通信组执行失败&lt;br&gt;终止其余参与者并保存诊断&lt;br&gt;新尝试整组重建，再做 5.1 预检" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="200" width="340" height="160" /></mxCell><mxCell id="failure" value="失败" source="N03" target="retry" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B07920;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.8043478260869565" y="0"><Array as="points"><mxPoint x="460" y="630.0" /><mxPoint x="460" y="280" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="back" value="重新核验" source="retry" target="N01" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B07920;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.375" y="0"><Array as="points"><mxPoint x="540" y="280.0" /><mxPoint x="540" y="230" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="source" value="网络与映射证据&lt;br&gt;网络路径基线、无损规则结果&lt;br&gt;端口、拓扑与 GPU 遥测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1000" y="200" width="340" height="160" /></mxCell><mxCell id="src" value="溯源输入" source="source" target="N06" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.6714285714285715" y="0"><Array as="points"><mxPoint x="1170.0" y="380" /><mxPoint x="1360" y="380" /><mxPoint x="1360" y="850" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="boundary" value="&lt;b&gt;5.8 评审出口&lt;/b&gt;&lt;br&gt;报告达标并确认调优清单后，解锁优雅退出。机内诊断不能直接证明交付通过；分组覆盖与全域单通信组分别报告。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="1100" width="1250" height="140" /></mxCell></root></mxGraphModel></diagram><diagram id="page-6" name="0.2 CMDB 全过程数据流"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;0.2 CMDB：每条源记录独立消费，全程自动沉淀&lt;/b&gt;&lt;br&gt;实线＝源记录发布后建立索引；虚线＝外部退出生命周期事件。没有等待五步齐备的全局门禁。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="20" width="1500" height="100" /></mxCell><mxCell id="network" value="1.1～1.8 网络底座&lt;br&gt;物料／交换机身份／端口／配置／健康" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="180" width="390" height="130" /></mxCell><mxCell id="install" value="2.1 装机 · 2.2 硬件采集&lt;br&gt;BMC 与 OS 分源；完整与缺失均留存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="380" width="390" height="130" /></mxCell><mxCell id="inspect" value="3.1～3.5 验机与配置&lt;br&gt;硬件／拓扑／双侧邻居／映射／配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="580" width="390" height="130" /></mxCell><mxCell id="test" value="4.1～4.7 与 5.1～5.8 测试&lt;br&gt;计划／原始结果／指标／报告／评审" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="780" width="390" height="130" /></mxCell><mxCell id="repair" value="0.1 修复；持续观测与人工确认&lt;br&gt;处置记录／窗口／就绪／确认记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="530" y="780" width="390" height="130" /></mxCell><mxCell id="C01" value="&lt;b&gt;0.2 CMDB 自动沉淀与维护查询&lt;/b&gt;&lt;br&gt;每次源记录发布即更新资产索引；把五步数据连成设备档案，供维护查询。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="380" width="440" height="170" /></mxCell><mxCell id="to-network" value="源记录引用" source="network" target="C01" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.28787878787878785" y="0"><Array as="points"><mxPoint x="460" y="245.0" /><mxPoint x="460" y="460" /><mxPoint x="540" y="460" /><mxPoint x="540" y="465.0" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="to-install" value="源记录引用" source="install" target="C01" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.2142857142857143" y="0"><Array as="points"><mxPoint x="460" y="445.0" /><mxPoint x="460" y="440" /><mxPoint x="540" y="440" /><mxPoint x="540" y="465.0" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="to-inspect" value="源记录引用" source="inspect" target="C01" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.6206896551724138" y="0"><Array as="points"><mxPoint x="460" y="645.0" /><mxPoint x="460" y="640" /><mxPoint x="540" y="640" /><mxPoint x="540" y="465.0" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="to-test" value="源记录引用" source="test" target="C01" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.74" y="0"><Array as="points"><mxPoint x="460" y="845.0" /><mxPoint x="460" y="460" /><mxPoint x="540" y="460" /><mxPoint x="540" y="465.0" /></Array><mxPoint as="offset" x="0.0" y="12.0" /></mxGeometry></mxCell><mxCell id="to-repair" value="源记录引用" source="repair" target="C01" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.26315789473684204" y="0"><Array as="points"><mxPoint x="725.0" y="760" /><mxPoint x="780" y="760" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="view" value="设备 360°／项目查询／API 导出&lt;br&gt;按设备、端口、版本追到原始证据&lt;br&gt;当前可用性与历史结论分别展示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1110" y="380" width="420" height="170" /></mxCell><mxCell id="read" value="索引与质量状态" source="C01" target="view" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0