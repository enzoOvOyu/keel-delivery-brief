keColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.045454545454545414" y="0"><Array as="points"><mxPoint x="1245.0" y="300" /><mxPoint x="1240" y="300" /><mxPoint x="1240" y="480" /><mxPoint x="1245.0" y="480" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e4" value="有效结果" source="s4" target="g3" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.05555555555555558" y="0"><Array as="points"><mxPoint x="1245.0" y="640" /><mxPoint x="1240" y="640" /><mxPoint x="1240" y="780" /><mxPoint x="1245.0" y="780" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="blocked" value="缺任一侧必需证据&lt;br&gt;unknown → BLOCKED&lt;br&gt;不判空匹配成功" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="750" y="480" width="280" height="140" /></mxCell><mxCell id="fail" value="明确差异 → 分类故障工单&lt;br&gt;原始证据＋期望/实际&lt;br&gt;不把采集超时直接判线缆坏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="480" width="280" height="140" /></mxCell><mxCell id="repair" value="0.1 修复与定向复验&lt;br&gt;复验通过后提议关闭，网络工程师／交付组长确认&lt;br&gt;通常回到 3.3.2；拓扑变化先重做 3.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="800" width="550" height="140" /></mxCell><mxCell id="eb" value="缺测" source="s3" target="blocked" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.07594936708860756" y="0"><Array as="points"><mxPoint x="1080" y="225.0" /><mxPoint x="1080" y="550" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="ef" value="观测差异" source="s3" target="fail" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.6326530612244898" y="0"><Array as="points"><mxPoint x="1080" y="225.0" /><mxPoint x="1080" y="300" /><mxPoint x="700" y="300" /><mxPoint x="700" y="550" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="er" value="处置" source="fail" target="repair" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.4920634920634921" y="0"><Array as="points"><mxPoint x="550" y="780" /><mxPoint x="685.0" y="780" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="eback" value="显式范围重验" source="repair" target="s2" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B07920;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.7123287671232876" y="0"><Array as="points"><mxPoint x="685.0" y="780" /><mxPoint x="740" y="780" /><mxPoint x="740" y="310" /><mxPoint x="900" y="310" /><mxPoint x="900" y="300" /><mxPoint x="905.0" y="300" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="note" value="连接确认由本次三方比对产生；3.3.3 局部通过不能代替 3.3.4 最终确认。稳定物理端口在映射发布前已存在。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1030" width="1430" height="130" /></mxCell></root></mxGraphModel></diagram><diagram id="page-3" name="4 网络测试"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;4 网络测试：按检查维度提供证据&lt;/b&gt;&lt;br&gt;实线为上下文、观测或结果消费；虚线为负载与观测关联。层间调度仍待确认。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="20" width="1530" height="85" /></mxCell><mxCell id="plan" value="4.1 确认准入并冻结测试计划&lt;br&gt;配置与映射有效、网络就绪&lt;br&gt;目标／路径／档位／版本／资源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="630" y="160" width="390" height="140" /></mxCell><mxCell id="T01" value="4.2 检查链路、速率与光模块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="410" width="250" height="135" /></mxCell><mxCell id="pT01" value="本次上下文" source="plan" target="T01" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.4976744186046511" y="0"><Array as="points"><mxPoint x="360" y="230" /><mxPoint x="360" y="477.5" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="T02" value="4.3 验证 IP 可达性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="400" y="410" width="250" height="135" /></mxCell><mxCell id="pT02" value="本次上下文" source="plan" target="T02" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.38211382113821135" y="0"><Array as="points"><mxPoint x="620" y="230.0" /><mxPoint x="620" y="400" /><mxPoint x="660" y="400" /><mxPoint x="660" y="477.5" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="T03" value="4.4 验证 RDMA 写读通路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="410" width="250" height="135" /></mxCell><mxCell id="pT03" value="本次上下文" source="plan" target="T03" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points"><mxPoint x="825.0" y="320" /><mxPoint x="820" y="320" /><mxPoint x="820" y="400" /><mxPoint x="835.0" y="400" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="T04" value="4.5 验证多流负载与热点覆盖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="410" width="250" height="135" /></mxCell><mxCell id="pT04" value="本次上下文" source="plan" target="T04" parent="1" edge="1" style="edgeStyle=