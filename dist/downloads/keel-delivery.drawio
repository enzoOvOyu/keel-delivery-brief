<mxfile host="app.diagrams.net" modified="2026-10-26T00:00:00.000Z" agent="keel specification builder" version="24.7.17" type="device"><diagram id="page-1" name="五步交付与产物依赖"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1550" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;五步交付与产物依赖&lt;/b&gt;&lt;br&gt;编号为阅读位置；实线为产物消费。网络与服务器侧按需并行。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="25" width="1500" height="85" /></mxCell><mxCell id="F01" value="&lt;b&gt;1.1 导入物料与连接计划&lt;/b&gt;&lt;br&gt;建立可引用的稳定对象与期望连接。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="160" width="280" height="110" /></mxCell><mxCell id="F02" value="&lt;b&gt;1.2 制定网络实施计划&lt;/b&gt;&lt;br&gt;把已经商定的网络方案转换成可执行批次和配置输入。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="300" width="280" height="110" /></mxCell><mxCell id="F03" value="&lt;b&gt;1.3 检查开通环境&lt;/b&gt;&lt;br&gt;证明引导、采集和分发依赖可用。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="440" width="280" height="110" /></mxCell><mxCell id="F04" value="&lt;b&gt;1.4 开通交换机管理通道&lt;/b&gt;&lt;br&gt;使交换机身份可信且具备最小管理能力。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="580" width="280" height="110" /></mxCell><mxCell id="F05" value="&lt;b&gt;1.5 预校验网络侧接线&lt;/b&gt;&lt;br&gt;检查当前可观测网络连接，保留尚未出现的服务器观测缺口。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="720" width="280" height="110" /></mxCell><mxCell id="F06" value="&lt;b&gt;1.6 应用并核对网络配置&lt;/b&gt;&lt;br&gt;证明批准配置已在交换机生效。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="580" width="280" height="110" /></mxCell><mxCell id="F07" value="&lt;b&gt;1.7 检查网络健康与无损能力&lt;/b&gt;&lt;br&gt;提供网络准入事实和可被测试消费的观测证据。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="790" width="280" height="110" /></mxCell><mxCell id="F08" value="&lt;b&gt;1.8 验收并导出网络交付包&lt;/b&gt;&lt;br&gt;生成可核对的网络交付证据包。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1000" width="280" height="110" /></mxCell><mxCell id="H07" value="&lt;b&gt;2.2 收集装机硬件信息&lt;/b&gt;&lt;br&gt;将 BMC 与操作系统看到的硬件分别留存，给验机提供可追溯的原始清单。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="170" width="280" height="110" /></mxCell><mxCell id="H01" value="&lt;b&gt;2.1 安装系统并建立 SSH 互信&lt;/b&gt;&lt;br&gt;把裸机变成身份已确认、可执行采集的服务器。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="160" width="280" height="110" /></mxCell><mxCell id="H02" value="&lt;b&gt;3.1 核验硬件与系统信息&lt;/b&gt;&lt;br&gt;记录硬件与系统事实，为拓扑和线序提供输入。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="300" width="280" height="110" /></mxCell><mxCell id="H03" value="&lt;b&gt;3.2 验证机内 GPU–NIC 拓扑&lt;/b&gt;&lt;br&gt;证明GPU-NIC内部关系符合独立预期。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="440" width="280" height="110" /></mxCell><mxCell id="H04" value="&lt;b&gt;3.3 核对并确认物理接线&lt;/b&gt;&lt;br&gt;证明期望物理端口连接与两侧实测一致，并获最终确认。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="620" width="280" height="110" /></mxCell><mxCell id="H05" value="&lt;b&gt;3.4 发布已验证映射&lt;/b&gt;&lt;br&gt;发布所有后续配置和定位使用的同一映射版本。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="790" width="280" height="110" /></mxCell><mxCell id="H06" value="&lt;b&gt;3.5 应用并验证服务器基线配置&lt;/b&gt;&lt;br&gt;把确认后的关系转换为真实服务器配置并验证。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="960" width="280" height="110" /></mxCell><mxCell id="T00" value="&lt;b&gt;4.1 确认准入并冻结测试计划&lt;/b&gt;&lt;br&gt;固定本次测试范围和证明义务，避免范围在执行中漂移。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="1120" width="280" height="110" /></mxCell><mxCell id="T06" value="&lt;b&gt;4.7 汇总网络测试并发布证明&lt;/b&gt;&lt;br&gt;发布本次范围可以支持哪些后续通信任务的证明。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1320" y="1120" width="280" height="110" /></mxCell><mxCell id="N08" value="&lt;b&gt;5.8 评审报告与退出条件&lt;/b&gt;&lt;br&gt;确认本次交付测试达标并完成调优清单确认。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1320" y="1290" width="280" height="110" /></mxCell><mxCell id="e0" value="物料与连接计划" source="F01" target="F02" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e1" value="计划" source="F02" target="F03" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e2" value="环境自检" source="F03" target="F04" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e3" value="可管理／可观测事实" source="F04" target="F05" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e4" value="管理可达；不等于生产同步" source="F04" target="F06" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="80.0" y="-72.0" /></mxGeometry></mxCell><mxCell id="e5" value="批准意图" source="F02" target="F06" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.032258064516129004" y="0"><Array as="points"><mxPoint x="380" y="355.0" /><mxPoint x="380" y="635.0" /></Array><mxPoint as="offset" x="40.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e6" value="复采配置" source="F06" target="F07" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e7" value="健康与无损" source="F07" target="F08" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.04166666666666663" y="0"><Array as="points"><mxPoint x="380" y="845.0" /><mxPoint x="380" y="1055.0" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e8" value="同一BOM" source="F01" target="H01" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.014285714285714235" y="0"><Array as="points"><mxPoint x="380" y="215.0" /><mxPoint x="380" y="160" /><mxPoint x="940" y="160" /><mxPoint x="940" y="215.0" /></Array><mxPoint as="offset" x="0.0" y="-12.0" /></mxGeometry></mxCell><mxCell id="e9" value="OS＋SSH信任" source="H01" target="H02" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e10" value="硬件采集验收" source="H02" target="H03" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e11" value="拓扑" source="H03" target="H04" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e12" value="预校验与待核验端口" source="F05" target="H04" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.12857142857142856" y="0"><Array as="points"><mxPoint x="380" y="775.0" /><mxPoint x="380" y="780" /><mxPoint x="940" y="780" /><mxPoint x="940" y="675.0" /></Array><mxPoint as="offset" x="0.0" y="-12.0" /></mxGeometry></mxCell><mxCell id="e13" value="生产配置同步证据" source="F06" target="H04" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.1212121212121211" y="0"><Array as="points"><mxPoint x="680" y="635.0" /><mxPoint x="680" y="680" /><mxPoint x="940" y="680" /><mxPoint x="940" y="675.0" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e14" value="物理接线验收＋已确认接线关系" source="H04" target="H05" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e15" value="已验证映射版本" source="H05" target="H06" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e16" value="QoS意图一致性" source="F06" target="H06" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.5671641791044777" y="0"><Array as="points"><mxPoint x="680" y="635.0" /><mxPoint x="680" y="1020" /><mxPoint x="940" y="1020" /><mxPoint x="940" y="1015.0" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e17" value="基线配置验证证明" source="H06" target="T00" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e18" value="健康与无损能力证明" source="F07" target="T00" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.532258064516129" y="0"><Array as="points"><mxPoint x="680" y="845.0" /><mxPoint x="680" y="840" /><mxPoint x="940" y="840" /><mxPoint x="940" y="1175.0" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="e19" value="分层证据汇总，详见网络测试图" source="T00" target="T06" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="-0.09999999999999998" y="0"><Array as="points"><mxPoint x="1240" y="1175.0" /><mxPoint x="1240" y="1180" /><mxPoint x="1300" y="1180" /><mxPoint x="1300" y="1175.0" /></Array><mxPoint as="offset" x="0.0" y="72.0" /></mxGeometry></mxCell><mxCell id="e20" value="经 5.1～5.8 预检、测试与评审" source="T06" target="N08" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="install-inventory" value="执行通道" source="H01" target="H07" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points"><mxPoint x="940" y="215.0" /><mxPoint x="940" y="220" /><mxPoint x="860" y="220" /><mxPoint x="860" y="225.0" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="inventory-validate" value="硬件原始清单" source="H07" target="H02" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7560A8;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" x="0.5416666666666667" y="0"><Array as="points"><mxPoint x="860" y="225.0" /><mxPoint x="860" y="360" /><mxPoint x="940" y="360" /><mxPoint x="940" y="355.0" /></Array><mxPoint as="offset" x="0.0" y="0.0" /></mxGeometry></mxCell><mxCell id="fresh" value="&lt;b&gt;执行前刷新就绪证明&lt;/b&gt;&lt;br&gt;3.3 接线核验与 4.1 测试准入前刷新网络状态&lt;br&gt;默认有效期 30 秒；5.1 通信组预检再次核对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="1150" width="460" height="125" /></mxCell><mxCell id="boundary" value="&lt;b&gt;阅读边界&lt;/b&gt;&lt;br&gt;1.8 验收导出不额外阻断装机或测试。5.8 报告评审通过，只解锁退出流程。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1360" width="780" height="100" /></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="3.3 核对并确认物理接线"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;3.3 核对并确认物理接线&lt;/b&gt;&lt;br&gt;实线表示已定义的控制或判定分支；虚线表示定向复验回流。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="20" width="1430" height="80" /></mxCell><mxCell id="ready" value="3.3 开始条件&lt;br&gt;硬件采集与机内拓扑有效&lt;br&gt;端口已建模、配置就绪、邻居可读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="160" width="290" height="130" /></mxCell><mxCell id="s1" value="3.3.1 确认 GPU–NIC 关系&lt;br&gt;保存机内路径与亲和关系版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="160" width="290" height="130" /></mxCell><mxCell id="s2" value="3.3.2 采集双侧邻居与 MAC&lt;br&gt;主机实测＋交换机回读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="760" y="160" width="290" height="130" /></mxCell><mxCell id="s3" value="3.3.3 进行三方比对&lt;br&gt;期望连接 ↔ 主机实测 ↔ 交换机回读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="160" width="290" height="130" /></mxCell><mxCell id="s4" value="3.3.4 交付组长最终确认&lt;br&gt;完整步骤链＋关系版本＋确认记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#B8B4CA;fontSize=14;fontFamily=Arial;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="500" width="290" height="130" /></mxCell><mxCell id="g3" value="3.4 发布已验证映射&lt;br&gt;所需映射覆盖 100%，无冲突&lt;br&gt;发布不可变版本" style="rounded=1;w