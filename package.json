{
  "name": "keel-delivery-brief",
  "version": "1.5.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 spec/publish.py --output public && vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "python3 spec/publish.py --output public && npm run build:frontend",
    "build:frontend": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "check": "tsc --noEmit && node --check src/legacy/app.js && node --check server.mjs && python3 spec/verify_contracts.py",
    "start": "node server.mjs",
    "test:decisions": "node --experimental-strip-types --test tests/decision-engine.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "shadcn": "^4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
