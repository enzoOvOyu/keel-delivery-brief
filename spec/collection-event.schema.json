{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keel:review:collection-event:1",
  "title": "CMDB 源记录事件封装（评审约定，不是完整生产 API）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "project_id", "subject_refs", "source_kind", "source_ref", "source_sequence", "source_hash", "source_quality", "collected_at", "received_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "event_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "subject_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/objectRef"}},
    "source_kind": {"type": "string", "enum": ["bom", "plan", "env", "bootstrap", "pre_cable", "net_config", "health", "lossless", "network_export", "host_ready", "inventory", "g1", "topology", "g2", "mapping", "g4", "test_plan", "l1", "l2", "l3", "l4", "l5", "g5", "nccl_admission", "nccl_environment", "group_results", "metrics", "report", "trace", "tuning", "g6", "repair", "observations", "window", "readiness", "human"]},
    "source_ref": {"type": "object", "additionalProperties": false, "required": ["record_id", "revision"], "properties": {"record_id": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}}},
    "source_sequence": {"type": "integer", "minimum": 1},
    "source_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source_quality": {"enum": ["known", "unknown", "degraded", "approximation", "estimated"]},
    "collected_at": {"$ref": "#/$defs/time"},
    "received_at": {"$ref": "#/$defs/time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "\\S", "not": {"const": "latest"}},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "objectRef": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["project", "machine", "component", "physical_port", "cable", "fabric", "rack", "execution", "group_run", "issue"]}, "id": {"$ref": "#/$defs/id"}}}
  }
}
